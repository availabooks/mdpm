{
  "name": "mdpm-monorepo",
  "private": true,
  "description": "Markdown-based project & task management that lives in your repo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/availabooks/mdpm.git"
  },
  "homepage": "https://github.com/availabooks/mdpm#readme",
  "bugs": {
    "url": "https://github.com/availabooks/mdpm/issues"
  },
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/vscode"
  ],
  "scripts": {
    "build": "npm run build -w @mdpm/cli -w mdpm-vscode",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p packages/cli --noEmit && tsc -p packages/vscode --noEmit",
    "test": "vitest run",
    "mdpm": "node packages/cli/dist/mdpm.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
