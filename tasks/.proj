name: mdpm
description: ""
owner: Elijah Allen
# Agents may run the checks CI runs.
agent:
  allowedTools:
    - Bash(mdpm *)
    - Bash(git status*)
    - Bash(git diff*)
    - Bash(git log*)
    - Bash(git add *)
    - Bash(git commit *)
    - Bash(npm test)
    - Bash(npm run typecheck)
    - Bash(npm run build)
