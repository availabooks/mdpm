{
  "name": "mdpm-vscode",
  "displayName": "mdpm — AI flow for your repo",
  "description": "Idea → plan → executing → review → done: write ideas in markdown, approve the agent's plans, review its work. A flow board and project tree for ideas that live in your repo.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/availabooks/mdpm.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://mdpm.availabooks.com",
  "bugs": {
    "url": "https://github.com/availabooks/mdpm/issues"
  },
  "version": "0.1.0",
  "publisher": "mdpm",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/.proj"
  ],
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --target=node18 --format=cjs --external:vscode --outfile=dist/extension.js --minify && esbuild ../cli/src/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/mdpm.js --minify",
    "watch": "esbuild src/extension.ts --bundle --platform=node --target=node18 --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap --watch",
    "package": "npm run build && vsce package --no-dependencies --out mdpm-vscode.vsix"
  },
  "dependencies": {
    "@mdpm/core": "*"
  },
  "devDependencies": {
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.1.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "markdown",
        "extensions": [
          ".task"
        ]
      },
      {
        "id": "yaml",
        "filenames": [
          ".proj"
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mdpm",
          "title": "mdpm",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "mdpm": [
        {
          "id": "mdpm.projects",
          "name": "Projects",
          "icon": "media/icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mdpm.projects",
        "contents": "No projects found. A project is any folder with a .proj file.\n[Create a project](command:mdpm.newProject)"
      }
    ],
    "commands": [
      {
        "command": "mdpm.refresh",
        "title": "Refresh",
        "category": "mdpm",
        "icon": "$(refresh)"
      },
      {
        "command": "mdpm.openBoard",
        "title": "Open Flow Board",
        "category": "mdpm",
        "icon": "$(sparkle)"
      },
      {
        "command": "mdpm.newIdea",
        "title": "New Idea",
        "category": "mdpm",
        "icon": "$(lightbulb)"
      },
      {
        "command": "mdpm.newProject",
        "title": "New Project",
        "category": "mdpm",
        "icon": "$(new-folder)"
      },
      {
        "command": "mdpm.approve",
        "title": "Approve Plan",
        "category": "mdpm",
        "icon": "$(check)"
      },
      {
        "command": "mdpm.replan",
        "title": "Re-plan…",
        "category": "mdpm",
        "icon": "$(discard)"
      },
      {
        "command": "mdpm.planNow",
        "title": "Plan Now",
        "category": "mdpm",
        "icon": "$(play)"
      },
      {
        "command": "mdpm.unblock",
        "title": "Answer & Unblock",
        "category": "mdpm",
        "icon": "$(debug-continue)"
      },
      {
        "command": "mdpm.moveBackToPlan",
        "title": "Move Back to Plan Queue",
        "category": "mdpm"
      },
      {
        "command": "mdpm.accept",
        "title": "Accept",
        "category": "mdpm",
        "icon": "$(pass)"
      },
      {
        "command": "mdpm.rework",
        "title": "Rework…",
        "category": "mdpm",
        "icon": "$(reply)"
      },
      {
        "command": "mdpm.openPr",
        "title": "Open Pull Request",
        "category": "mdpm",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "mdpm.continueWithAgent",
        "title": "Continue with Agent",
        "category": "mdpm",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "mdpm.runNext",
        "title": "Run Agent: Next in the Flow",
        "category": "mdpm",
        "icon": "$(play-circle)"
      },
      {
        "command": "mdpm.runUntilIdle",
        "title": "Run Agent: Until Nothing Is Left",
        "category": "mdpm"
      },
      {
        "command": "mdpm.linkTask",
        "title": "Add to Another Project (link)…",
        "category": "mdpm"
      },
      {
        "command": "mdpm.unlinkTask",
        "title": "Remove from This Project (unlink)",
        "category": "mdpm"
      },
      {
        "command": "mdpm.openProjectFile",
        "title": "Edit Project Settings (.proj)",
        "category": "mdpm"
      },
      {
        "command": "mdpm.revealInExplorer",
        "title": "Reveal in Explorer",
        "category": "mdpm"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "mdpm.newIdea",
          "when": "view == mdpm.projects",
          "group": "navigation@1"
        },
        {
          "command": "mdpm.openBoard",
          "when": "view == mdpm.projects",
          "group": "navigation@2"
        },
        {
          "command": "mdpm.runNext",
          "when": "view == mdpm.projects",
          "group": "navigation@3"
        },
        {
          "command": "mdpm.refresh",
          "when": "view == mdpm.projects",
          "group": "navigation@4"
        },
        {
          "command": "mdpm.newProject",
          "when": "view == mdpm.projects",
          "group": "more@1"
        },
        {
          "command": "mdpm.runUntilIdle",
          "when": "view == mdpm.projects",
          "group": "more@2"
        }
      ],
      "view/item/context": [
        {
          "command": "mdpm.newIdea",
          "when": "viewItem == project",
          "group": "inline"
        },
        {
          "command": "mdpm.newIdea",
          "when": "viewItem == project",
          "group": "1_create@1"
        },
        {
          "command": "mdpm.newProject",
          "when": "viewItem == project",
          "group": "1_create@2"
        },
        {
          "command": "mdpm.openBoard",
          "when": "viewItem == project",
          "group": "2_view@1"
        },
        {
          "command": "mdpm.openProjectFile",
          "when": "viewItem == project",
          "group": "3_edit"
        },
        {
          "command": "mdpm.planNow",
          "when": "viewItem =~ /^idea.*:idea$/",
          "group": "inline"
        },
        {
          "command": "mdpm.approve",
          "when": "viewItem =~ /^idea.*:plan$/",
          "group": "inline"
        },
        {
          "command": "mdpm.unblock",
          "when": "viewItem =~ /^idea.*:blocked$/",
          "group": "inline"
        },
        {
          "command": "mdpm.accept",
          "when": "viewItem =~ /^idea.*:review$/",
          "group": "inline"
        },
        {
          "command": "mdpm.planNow",
          "when": "viewItem =~ /^idea.*:idea$/",
          "group": "0_flow@1"
        },
        {
          "command": "mdpm.approve",
          "when": "viewItem =~ /^idea.*:(plan|idea)$/",
          "group": "0_flow@2"
        },
        {
          "command": "mdpm.replan",
          "when": "viewItem =~ /^idea.*:plan(-approved)?$/",
          "group": "0_flow@3"
        },
        {
          "command": "mdpm.unblock",
          "when": "viewItem =~ /^idea.*:blocked$/",
          "group": "0_flow@4"
        },
        {
          "command": "mdpm.moveBackToPlan",
          "when": "viewItem =~ /^idea.*:executing$/",
          "group": "0_flow@5"
        },
        {
          "command": "mdpm.accept",
          "when": "viewItem =~ /^idea.*:review$/",
          "group": "0_flow@6"
        },
        {
          "command": "mdpm.rework",
          "when": "viewItem =~ /^idea.*:review$/",
          "group": "0_flow@7"
        },
        {
          "command": "mdpm.openPr",
          "when": "viewItem =~ /^idea.*:(review|done)$/",
          "group": "0_flow@8"
        },
        {
          "command": "mdpm.continueWithAgent",
          "when": "viewItem =~ /^idea.*:(plan|plan-approved|executing|blocked|review|done)$/",
          "group": "1_agent@1"
        },
        {
          "command": "mdpm.linkTask",
          "when": "viewItem =~ /^idea/",
          "group": "2_link@1"
        },
        {
          "command": "mdpm.unlinkTask",
          "when": "viewItem =~ /^ideaLink/",
          "group": "2_link@2"
        },
        {
          "command": "mdpm.revealInExplorer",
          "when": "viewItem =~ /^(project|idea)/",
          "group": "9_reveal"
        }
      ],
      "commandPalette": [
        {
          "command": "mdpm.unlinkTask",
          "when": "false"
        },
        {
          "command": "mdpm.openProjectFile",
          "when": "false"
        },
        {
          "command": "mdpm.revealInExplorer",
          "when": "false"
        },
        {
          "command": "mdpm.approve",
          "when": "mdpm.activeTaskState =~ /^(plan|idea)$/"
        },
        {
          "command": "mdpm.replan",
          "when": "mdpm.activeTaskState =~ /^plan/"
        },
        {
          "command": "mdpm.planNow",
          "when": "mdpm.activeTaskState == idea"
        },
        {
          "command": "mdpm.unblock",
          "when": "mdpm.activeTaskState == blocked"
        },
        {
          "command": "mdpm.moveBackToPlan",
          "when": "mdpm.activeTaskState == executing"
        },
        {
          "command": "mdpm.accept",
          "when": "mdpm.activeTaskState == review"
        },
        {
          "command": "mdpm.rework",
          "when": "mdpm.activeTaskState == review"
        },
        {
          "command": "mdpm.openPr",
          "when": "mdpm.activeTask"
        },
        {
          "command": "mdpm.continueWithAgent",
          "when": "mdpm.activeTask"
        },
        {
          "command": "mdpm.linkTask",
          "when": "mdpm.activeTask"
        }
      ],
      "editor/title": [
        {
          "command": "mdpm.planNow",
          "when": "mdpm.activeTaskState == idea",
          "group": "navigation@90"
        },
        {
          "command": "mdpm.approve",
          "when": "mdpm.activeTaskState == plan",
          "group": "navigation@90"
        },
        {
          "command": "mdpm.unblock",
          "when": "mdpm.activeTaskState == blocked",
          "group": "navigation@90"
        },
        {
          "command": "mdpm.accept",
          "when": "mdpm.activeTaskState == review",
          "group": "navigation@90"
        },
        {
          "command": "mdpm.rework",
          "when": "mdpm.activeTaskState == review",
          "group": "navigation@91"
        },
        {
          "command": "mdpm.continueWithAgent",
          "when": "mdpm.activeTask && mdpm.activeTaskState != idea",
          "group": "navigation@92"
        }
      ]
    },
    "configuration": {
      "title": "mdpm",
      "properties": {
        "mdpm.root": {
          "type": "string",
          "default": "",
          "description": "Folder (relative to each workspace folder) to scan for projects. Set this when mdpm lives inside a large repo, e.g. \"tasks\"."
        },
        "mdpm.agent.default": {
          "type": "string",
          "default": "claude",
          "description": "Agent that Plan Now and Run Agent use: claude, codex, cursor, or an agent defined under \"agents:\" in the root .proj."
        }
      }
    }
  }
}
