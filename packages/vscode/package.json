{
  "name": "mdpm-vscode",
  "displayName": "mdpm — Markdown Projects & Tasks",
  "description": "Kanban board, waterfall timeline and project tree for markdown tasks that live in your repo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/availabooks/mdpm.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://github.com/availabooks/mdpm#readme",
  "bugs": {
    "url": "https://github.com/availabooks/mdpm/issues"
  },
  "version": "0.1.0",
  "publisher": "mdpm",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/.proj"
  ],
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --target=node18 --format=cjs --external:vscode --outfile=dist/extension.js --minify && esbuild ../cli/src/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/mdpm.js --minify",
    "watch": "esbuild src/extension.ts --bundle --platform=node --target=node18 --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap --watch",
    "package": "npm run build && vsce package --no-dependencies --out mdpm-vscode.vsix"
  },
  "dependencies": {
    "@mdpm/core": "*"
  },
  "devDependencies": {
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.1.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "markdown",
        "extensions": [
          ".task"
        ]
      },
      {
        "id": "yaml",
        "filenames": [
          ".proj"
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mdpm",
          "title": "mdpm",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "mdpm": [
        {
          "id": "mdpm.projects",
          "name": "Projects",
          "icon": "media/icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mdpm.projects",
        "contents": "No projects found. A project is any folder with a .proj file.\n[Create a project](command:mdpm.newProject)"
      }
    ],
    "commands": [
      {
        "command": "mdpm.refresh",
        "title": "Refresh",
        "category": "mdpm",
        "icon": "$(refresh)"
      },
      {
        "command": "mdpm.openBoard",
        "title": "Open Kanban Board",
        "category": "mdpm",
        "icon": "$(project)"
      },
      {
        "command": "mdpm.openWaterfall",
        "title": "Open Waterfall Timeline",
        "category": "mdpm",
        "icon": "$(graph-line)"
      },
      {
        "command": "mdpm.newTask",
        "title": "New Task",
        "category": "mdpm",
        "icon": "$(add)"
      },
      {
        "command": "mdpm.newProject",
        "title": "New Project",
        "category": "mdpm",
        "icon": "$(new-folder)"
      },
      {
        "command": "mdpm.setStatus",
        "title": "Set Status…",
        "category": "mdpm"
      },
      {
        "command": "mdpm.setOwner",
        "title": "Set Owner…",
        "category": "mdpm"
      },
      {
        "command": "mdpm.linkTask",
        "title": "Add to Another Project (link)…",
        "category": "mdpm"
      },
      {
        "command": "mdpm.unlinkTask",
        "title": "Remove from This Project (unlink)",
        "category": "mdpm"
      },
      {
        "command": "mdpm.openProjectFile",
        "title": "Edit Project Settings (.proj)",
        "category": "mdpm"
      },
      {
        "command": "mdpm.revealInExplorer",
        "title": "Reveal in Explorer",
        "category": "mdpm"
      },
      {
        "command": "mdpm.sendToAgent",
        "title": "Send to Agent",
        "category": "mdpm",
        "icon": "$(hubot)"
      },
      {
        "command": "mdpm.sendToAgentAs",
        "title": "Send to Agent…",
        "category": "mdpm"
      },
      {
        "command": "mdpm.queueForAgent",
        "title": "Queue for Agent…",
        "category": "mdpm"
      },
      {
        "command": "mdpm.unblock",
        "title": "Unblock",
        "category": "mdpm",
        "icon": "$(debug-continue)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "mdpm.newTask",
          "when": "view == mdpm.projects",
          "group": "navigation@1"
        },
        {
          "command": "mdpm.openBoard",
          "when": "view == mdpm.projects",
          "group": "navigation@2"
        },
        {
          "command": "mdpm.openWaterfall",
          "when": "view == mdpm.projects",
          "group": "navigation@3"
        },
        {
          "command": "mdpm.refresh",
          "when": "view == mdpm.projects",
          "group": "navigation@4"
        },
        {
          "command": "mdpm.newProject",
          "when": "view == mdpm.projects",
          "group": "more"
        }
      ],
      "view/item/context": [
        {
          "command": "mdpm.newTask",
          "when": "viewItem == project",
          "group": "inline"
        },
        {
          "command": "mdpm.newTask",
          "when": "viewItem == project",
          "group": "1_create@1"
        },
        {
          "command": "mdpm.newProject",
          "when": "viewItem == project",
          "group": "1_create@2"
        },
        {
          "command": "mdpm.openBoard",
          "when": "viewItem == project",
          "group": "2_view@1"
        },
        {
          "command": "mdpm.openWaterfall",
          "when": "viewItem == project",
          "group": "2_view@2"
        },
        {
          "command": "mdpm.openProjectFile",
          "when": "viewItem == project",
          "group": "3_edit"
        },
        {
          "command": "mdpm.setStatus",
          "when": "viewItem =~ /^task/",
          "group": "1_edit@1"
        },
        {
          "command": "mdpm.setOwner",
          "when": "viewItem =~ /^task/",
          "group": "1_edit@2"
        },
        {
          "command": "mdpm.linkTask",
          "when": "viewItem =~ /^task/",
          "group": "2_link@1"
        },
        {
          "command": "mdpm.unlinkTask",
          "when": "viewItem =~ /^taskLink/",
          "group": "2_link@2"
        },
        {
          "command": "mdpm.revealInExplorer",
          "when": "viewItem",
          "group": "9_reveal"
        },
        {
          "command": "mdpm.sendToAgent",
          "when": "viewItem =~ /^task.*:open$/",
          "group": "inline"
        },
        {
          "command": "mdpm.unblock",
          "when": "viewItem =~ /^task.*:blocked$/",
          "group": "inline"
        },
        {
          "command": "mdpm.sendToAgent",
          "when": "viewItem =~ /^task.*:open$/",
          "group": "0_agent@1"
        },
        {
          "command": "mdpm.sendToAgentAs",
          "when": "viewItem =~ /^task.*:open$/",
          "group": "0_agent@2"
        },
        {
          "command": "mdpm.queueForAgent",
          "when": "viewItem =~ /^task.*:open$/",
          "group": "0_agent@3"
        },
        {
          "command": "mdpm.unblock",
          "when": "viewItem =~ /^task.*:blocked$/",
          "group": "0_agent@1"
        }
      ],
      "commandPalette": [
        {
          "command": "mdpm.unlinkTask",
          "when": "false"
        },
        {
          "command": "mdpm.openProjectFile",
          "when": "false"
        },
        {
          "command": "mdpm.revealInExplorer",
          "when": "false"
        },
        {
          "command": "mdpm.unblock",
          "when": "mdpm.activeTaskBlocked"
        }
      ],
      "editor/title": [
        {
          "command": "mdpm.sendToAgent",
          "when": "mdpm.activeTask && !mdpm.activeTaskBlocked",
          "group": "navigation@90"
        },
        {
          "command": "mdpm.unblock",
          "when": "mdpm.activeTaskBlocked",
          "group": "navigation@90"
        }
      ]
    },
    "configuration": {
      "title": "mdpm",
      "properties": {
        "mdpm.root": {
          "type": "string",
          "default": "",
          "description": "Folder (relative to each workspace folder) to scan for projects. Set this when mdpm lives inside a large repo, e.g. \"tasks\"."
        },
        "mdpm.defaultOwner": {
          "type": "string",
          "default": "",
          "description": "Owner for new tasks. Leave empty to leave tasks unassigned."
        },
        "mdpm.agent.default": {
          "type": "string",
          "default": "claude",
          "description": "Agent that \"Send to Agent\" runs: claude, codex, cursor, or an agent defined under \"agents:\" in the root .proj. \"Send to Agent…\" picks another one."
        },
        "mdpm.taskTemplate": {
          "type": "string",
          "enum": [
            "agent",
            "default"
          ],
          "default": "agent",
          "enumDescriptions": [
            "Goal, Context, Acceptance criteria, Verification, Constraints and Questions: everything an agent needs to work on the task unattended.",
            "Description and Acceptance criteria only."
          ],
          "description": "Body of tasks created with \"New Task\"."
        }
      }
    }
  }
}
